#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Pre-push hook for Credit Card Dashboard
# This runs comprehensive quality checks before allowing a push
# 
# Checks performed:
# 1. Dependency verification (deps:verify)
# 2. Strict TypeScript compilation (typecheck:strict)
# 3. Linting (lint)
# 4. Render deployment simulation (render:simulate)
#
# If any check fails, the push is blocked.
# To bypass (NOT recommended): git push --no-verify

echo "🔒 Running pre-push quality gate..."
echo ""

npm run prepush

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Pre-push checks failed!"
  echo "Fix the errors above before pushing."
  echo ""
  echo "To bypass these checks (NOT recommended):"
  echo "  git push --no-verify"
  echo ""
  exit 1
fi

echo ""
echo "✅ All pre-push checks passed!"
echo "Proceeding with push..."
echo ""
