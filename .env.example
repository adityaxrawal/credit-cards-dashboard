# ============================================================================
# Credit Card Dashboard - Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# Application Settings
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# ----------------------------------------------------------------------------
# Database (Supabase)
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:port/database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----------------------------------------------------------------------------
# Redis (Upstash)
# ----------------------------------------------------------------------------
# Preferred: REST API (simpler, no connection overhead)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token

# Alternative: ioredis connection (if USE_IOREDIS=true)
USE_IOREDIS=false
REDIS_URL=redis://default:password@host:port

# ----------------------------------------------------------------------------
# JWT Authentication
# ----------------------------------------------------------------------------
# Secret keys for signing tokens (use strong random strings)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production

# Token expiration settings (customize as needed)
# Format: Use 's' for seconds, 'm' for minutes, 'h' for hours, 'd' for days
# Examples: "60s", "15m", "1h", "7d"
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# Session expiry in seconds (7 days = 604800 seconds)
SESSION_EXPIRY_SECONDS=604800

# ----------------------------------------------------------------------------
# Gmail API (Google OAuth)
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Gmail token encryption (for storing refresh tokens securely)
GMAIL_TOKEN_ENCRYPTION_KEY=your-32-character-encryption-key
GMAIL_TOKEN_ENCRYPTION_TTL_DAYS=3650

# ----------------------------------------------------------------------------
# Monitoring & Logging
# ----------------------------------------------------------------------------
# Sentry (for error tracking and performance monitoring)
# Backend DSN (used in Node.js server)
SENTRY_DSN_BACKEND=https://your-backend-sentry-dsn@sentry.io/project-id

# Frontend DSN (used in Next.js - must be prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_SENTRY_DSN=https://your-frontend-sentry-dsn@sentry.io/project-id

# Environment name (production, staging, development)
NEXT_PUBLIC_ENVIRONMENT=development

# Sentry tracing sample rate (0.0 to 1.0)
# 1.0 = 100% of transactions traced (use in development)
# 0.1 = 10% of transactions traced (recommended for production to stay within free tier)
SENTRY_TRACES_SAMPLE_RATE=1.0

# Log level: error, warn, info, debug
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# CORS Settings
# ----------------------------------------------------------------------------
# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# ----------------------------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------------------------
# Requests per window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ----------------------------------------------------------------------------
# Admin Configuration
# ----------------------------------------------------------------------------
# Comma-separated list of admin email addresses
ADMIN_EMAILS=admin@example.com,your-email@example.com

# ----------------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------------
ENABLE_ANALYTICS_TRACKING=true
ENABLE_FEEDBACK_SYSTEM=true
ENABLE_GMAIL_SYNC=true

# ----------------------------------------------------------------------------
# Zero-Cost Deployment Notes
# ----------------------------------------------------------------------------
# This configuration is optimized for zero-cost deployment:
# - Render (backend): Free tier
# - Vercel (frontend): Free tier
# - Supabase (PostgreSQL): Free tier
# - Upstash (Redis): Free tier (10K commands/day)
#
# Ensure you stay within free tier limits:
# - Render: 750 hours/month, sleeps after 15 min inactivity
# - Vercel: 100GB bandwidth, unlimited requests
# - Supabase: 500MB database, 2GB transfer
# - Upstash: 10,000 commands/day
# ============================================================================
