# GlitchTip Deployment Configuration
# Copy this file to glitchtip-config.env and fill in your values

# Google Cloud Project Configuration
PROJECT_ID="your-gcp-project-id"
REGION="us-central1"

# GlitchTip Service Configuration
SERVICE_NAME="glitchtip"
GLITCHTIP_DOMAIN="https://glitchtip.yourdomain.com"

# Database Configuration
DB_INSTANCE_NAME="glitchtip-db"
DB_NAME="glitchtip"
DB_USER="glitchtip"
DB_PASSWORD="your-secure-database-password"

# Redis Configuration (Upstash or self-hosted)
REDIS_URL="redis://user:password@host:port/db"

# GlitchTip Secret Key (generate with: openssl rand -hex 32)
SECRET_KEY="your-secret-key-here"

# Email Configuration (optional)
EMAIL_BACKEND="django.core.mail.backends.smtp.EmailBackend"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USE_TLS="True"
EMAIL_HOST_USER="your-email@gmail.com"
EMAIL_HOST_PASSWORD="your-app-password"
DEFAULT_FROM_EMAIL="noreply@yourdomain.com"

# Registration Settings
ENABLE_OPEN_USER_REGISTRATION="False"

# Environment
ENVIRONMENT="production"
