{
  "name": "credit-card-backend",
  "version": "1.0.0",
  "description": "Backend services for Credit Card Dashboard",
  "main": "dist/app.js",
  "private": true,
  "scripts": {
    "dev": "nodemon -r tsconfig-paths/register src/server.ts",
    "dev-logs": "nodemon -r tsconfig-paths/register src/server.ts 2>&1 | tee logs/console-backend.log",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "migrate": "ts-node -r tsconfig-paths/register src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "clear-db": "ts-node -r tsconfig-paths/register scripts/clear_db.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@sentry/node": "^10.22.0",
    "@types/cheerio": "^0.22.35",
    "@upstash/redis": "^1.35.7",
    "cheerio": "^1.1.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "dayjs": "^1.11.19",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.2.0",
    "google-auth-library": "^10.5.0",
    "googleapis": "^133.0.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.11",
    "p-limit": "^3.1.0",
    "pdfjs-dist": "^5.4.449",
    "pg": "^8.16.3",
    "socket.io": "^4.8.1",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "winston": "^3.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/csurf": "^1.11.5",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.25",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.15.6",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "husky": "^8.0.3",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.0.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
