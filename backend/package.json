{
  "name": "credit-card-backend",
  "version": "1.0.0",
  "description": "Backend services for Credit Card Dashboard",
  "private": true,
  "scripts": {
    "dev": "npm run dev --workspace=api-gateway",
    "dev:gateway": "npm run dev --workspace=api-gateway",
    "build": "npm run build --workspace=api-gateway",
    "build:all": "npm run build --workspaces",
    "start": "npm start --workspace=api-gateway",
    "test": "npm test --workspaces",
    "lint": "npm run lint --workspaces",
    "clean": "rm -rf node_modules services/*/node_modules shared/node_modules"
  },
  "workspaces": [
    "services/api-gateway",
    "shared"
  ],
  "dependencies": {
    "@sentry/node": "^10.22.0",
    "@sentry/profiling-node": "^10.22.0",
    "@supabase/supabase-js": "^2.42.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "googleapis": "^133.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "winston": "^3.18.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.30",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.3"
  }
}
