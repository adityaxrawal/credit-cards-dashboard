{
  "name": "credit-card-backend",
  "version": "1.0.0",
  "description": "Backend services for Credit Card Dashboard",
  "main": "services/api-gateway/dist/api-gateway/src/index.js",
  "private": true,
  "scripts": {
    "dev": "nodemon --exec ts-node -r tsconfig-paths/register services/api-gateway/src/index.ts",
    "build": "npm run build:shared && npm run build:gateway",
    "build:shared": "tsc --project services/shared/tsconfig.json",
    "build:gateway": "tsc --project services/api-gateway/tsconfig.json && tsc-alias -p services/api-gateway/tsconfig.json",
    "build:clean": "rm -rf services/api-gateway/dist services/shared/dist && npm run build",
    "start": "node services/api-gateway/dist/api-gateway/src/index.js",
    "lint": "eslint services/api-gateway/src --ext .ts",
    "lint:fix": "eslint services/api-gateway/src --ext .ts --fix",
    "format": "prettier --write \"services/api-gateway/src/**/*.ts\" \"services/shared/**/*.ts\"",
    "format:check": "prettier --check \"services/api-gateway/src/**/*.ts\" \"services/shared/**/*.ts\"",
    "typecheck": "tsc --noEmit --project services/api-gateway/tsconfig.json && tsc --noEmit --project services/shared/tsconfig.json",
    "typecheck:strict": "tsc --noEmit --skipLibCheck false --strict --project services/api-gateway/tsconfig.json",
    "clean": "rm -rf node_modules services/api-gateway/dist services/shared/dist",
  "prepare": "echo 'husky hooks are managed at repository root (.husky)'",
    "test": "echo \"No tests specified yet\"",
    "pre-push": "npm run lint && npm run typecheck && npm run build",
    "ensure-deps": "bash scripts/ensure-deps.sh",
    "deps:verify": "npm run ensure-deps && node services/api-gateway/scripts/deps-verify.js",
    "render:simulate": "node services/api-gateway/scripts/render-simulate.js"
  },
  "dependencies": {
    "@sentry/node": "^10.22.0",
    "@sentry/profiling-node": "^10.22.0",
    "@supabase/supabase-js": "^2.42.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "googleapis": "^133.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "redis": "^4.7.0",
    "winston": "^3.18.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.30",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "husky": "^8.0.3",
    "nodemon": "^3.1.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.3"
  }
}
