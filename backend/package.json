{
  "name": "credit-card-backend",
  "version": "1.0.0",
  "description": "Backend services for Credit Card Dashboard",
  "private": true,
  "scripts": {
    "dev": "npm run dev --workspace=api-gateway",
    "dev:gateway": "npm run dev --workspace=api-gateway",
    "dev:gmail": "npm run dev --workspace=gmail-service",
    "dev:all": "concurrently \"npm run dev:gateway\" \"npm run dev:gmail\"",
    "build": "npm run build --workspace=api-gateway",
    "build:all": "npm run build --workspaces",
    "start": "npm start --workspace=api-gateway",
    "test": "npm test --workspaces",
    "lint": "npm run lint --workspaces"
  },
  "workspaces": [
    "services/api-gateway",
    "services/gmail-service",
    "shared"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
