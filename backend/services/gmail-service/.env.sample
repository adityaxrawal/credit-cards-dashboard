# Gmail Service Environment Variables
# Copy this to .env and fill in actual values

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Encryption Key (32 bytes minimum for AES-256)
ENCRYPTION_KEY=your_32_character_encryption_key_here_minimum
# Or use JWT_SECRET as fallback
JWT_SECRET=your_jwt_secret_here_32_chars_min

# Gmail Pub/Sub Configuration
GMAIL_PUBSUB_TOPIC=projects/your-project-id/topics/gmail-notifications
GMAIL_PUBSUB_SUBSCRIPTION=projects/your-project-id/subscriptions/gmail-subscription

# Feature Flags
FEATURE_FLAG_EMAIL_INTEGRATION=true
GMAIL_MOCK_MODE=false # Set to true for testing with mock Gmail API

# Service Configuration
GMAIL_SERVICE_PORT=3004
NODE_ENV=development
LOG_LEVEL=debug

# Redis Configuration (for queue)
REDIS_URL=redis://localhost:6379
# Or use Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Rate Limiting
GMAIL_API_RATE_LIMIT=250 # requests per user per second
GMAIL_API_DAILY_QUOTA=1000000000 # Gmail API daily quota

# Retry Configuration
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_MS=1000
DLQ_THRESHOLD=3

# Monitoring
METRICS_ENABLED=true
SENTRY_DSN=your_sentry_dsn_here # optional
