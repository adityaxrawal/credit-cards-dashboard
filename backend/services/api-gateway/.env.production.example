# ⚠️ NEVER COMMIT FILES WITH REAL SECRETS!
# Replace ALL placeholders with your actual credentials

NODE_ENV=production
PORT=10000
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGINS=https://your-app.vercel.app

# Supabase - Get from: https://supabase.com/dashboard
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx.replace_with_your_key
SUPABASE_SERVICE_KEY=eyJxxxxx.replace_with_your_key
SUPABASE_ANON_KEY=eyJxxxxx.replace_with_your_key
DATABASE_URL=postgresql://postgres:password@host.supabase.com:6543/postgres

# JWT - Generate with: openssl rand -base64 32
JWT_SECRET=GENERATE_NEW_SECRET_HERE
JWT_REFRESH_SECRET=GENERATE_NEW_SECRET_HERE
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# Google OAuth - Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-secret-here
GOOGLE_REDIRECT_URI=https://xxxxx.supabase.co/auth/v1/callback
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/gmail-notification

# Upstash Redis - Get from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here
REDIS_URL=redis://default:token@xxxxx.upstash.io:6379
USE_REDIS_REST_API=true

# QStash
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=your_token_here
QSTASH_CURRENT_SIGNING_KEY=sig_xxxxx
QSTASH_NEXT_SIGNING_KEY=sig_xxxxx
