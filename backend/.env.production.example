# Production Environment Variables for Render Deployment
# Copy this to your Render Dashboard Environment Variables section

NODE_ENV=production
PORT=10000

# Frontend URL (update with your Vercel deployment URL)
FRONTEND_URL=https://credit-cards-dashboard-frontend.vercel.app
CORS_ORIGINS=https://credit-cards-dashboard-frontend.vercel.app

# Supabase Configuration
SUPABASE_URL=https://ythuxanwxzdwtuwotcha.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Database
DATABASE_URL=postgresql://user:password@host:port/database

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# Redis Configuration (Upstash)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here
REDIS_URL=redis://default:token@host:6379
USE_REDIS_REST_API=true

# Google OAuth & Gmail API
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=https://ythuxanwxzdwtuwotcha.supabase.co/auth/v1/callback

# Encryption
ENCRYPTION_KEY=your_encryption_key_32_chars_min

# Logging
LOG_LEVEL=info
LOG_JSON=true
ENABLE_FILE_LOGGING=false

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1
RATE_LIMIT_GMAIL_MAX=10
RATE_LIMIT_AUTH_MAX=20

# Feature Flags
ENABLE_GMAIL_SYNC=true
ENABLE_AUTO_EXTRACTION=true
ENABLE_BUDGET_ALERTS=true

# Error Tracking (Optional)
SENTRY_DSN=
SENTRY_ENABLED=false
GLITCHTIP_DSN=
GLITCHTIP_ENABLED=false

# Application Version
APP_VERSION=1.0.0
