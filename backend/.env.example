# Financial Tracker - Environment Variables
# Copy this file to .env and fill in the values

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL=postgresql://username:password@localhost:5432/financial_tracker
# Or use separate variables:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_NAME=financial_tracker

# ===========================================
# SERVER
# ===========================================
PORT=3001
NODE_ENV=production

# ===========================================
# AUTHENTICATION
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ===========================================
# GMAIL API (for email sync)
# ===========================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# ===========================================
# ENCRYPTION (for backups)
# ===========================================
BACKUP_ENCRYPTION_KEY=your-32-byte-encryption-key-here

# ===========================================
# CURRENCY RATES API (optional)
# ===========================================
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key

# ===========================================
# MONITORING
# ===========================================
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

# ===========================================
# JOB SCHEDULER
# ===========================================
ENABLE_SCHEDULED_JOBS=true
BALANCE_SNAPSHOT_CRON="0 0 * * *"
EMI_REMINDER_CRON="0 8 * * *"
ANALYTICS_REFRESH_CRON="0 */6 * * *"
BILL_DETECTION_CRON="0 2 * * 0"
RECURRING_PATTERN_CRON="0 3 * * 0"
