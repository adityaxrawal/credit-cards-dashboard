#!/bin/bash

# Project ID
PROJECT_ID="credit-card-management-475304"
SERVICE_NAME="backend"
REGION="us-central1" # You can change this to your preferred region

# Build the image using Cloud Build
echo "Building Docker image..."
gcloud builds submit --tag gcr.io/$PROJECT_ID/$SERVICE_NAME backend

# Deploy to Cloud Run
echo "Deploying to Cloud Run..."
gcloud run deploy $SERVICE_NAME \
  --image gcr.io/$PROJECT_ID/$SERVICE_NAME \
  --platform managed \
  --region $REGION \
  --allow-unauthenticated \
  --set-env-vars NODE_ENV=production \
  --set-env-vars SUPABASE_URL="https://amudxjsljakgdrfvruea.supabase.co" \
  --set-env-vars SUPABASE_URL="YOUR_SUPABASE_URL" \
  --set-env-vars SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY" \
  --set-env-vars SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY" \
  --set-env-vars DATABASE_URL="YOUR_DATABASE_URL" \
  --set-env-vars GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID" \
  --set-env-vars GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET" \
  --set-env-vars GOOGLE_REDIRECT_URI="https://credit-cards-dashboard-frontend.vercel.app/login" \
  --set-env-vars UPSTASH_REDIS_REST_URL="YOUR_REDIS_URL" \
  --set-env-vars UPSTASH_REDIS_REST_TOKEN="YOUR_REDIS_TOKEN" \
  --set-env-vars ENCRYPTION_KEY="YOUR_ENCRYPTION_KEY" \
  --set-env-vars JWT_SECRET="YOUR_JWT_SECRET" \
  --set-env-vars JWT_REFRESH_SECRET="YOUR_JWT_REFRESH_SECRET" \
  --set-env-vars FRONTEND_URL="https://credit-cards-dashboard-frontend.vercel.app" \
  --set-env-vars ENABLE_GMAIL_SYNC="true" \
  --set-env-vars ENABLE_AUTO_EXTRACTION="true" \
  --set-env-vars ENABLE_BUDGET_ALERTS="true"

echo "Deployment complete!"
