{
  "name": "credit-card-dashboard",
  "version": "1.0.0",
  "description": "Personal credit card management and analytics dashboard",
  "private": true,
  "scripts": {
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "backend:dev": "cd backend/services/api-gateway && npm run dev",
    "backend:build": "cd backend/services/api-gateway && npm run build",
    "db:migrate:up": "cd database && npm run migrate:up",
    "db:migrate:down": "cd database && npm run migrate:down",
    "lint": "npm run frontend:lint && npm run backend:lint",
    "frontend:lint": "cd frontend && npm run lint",
    "backend:lint": "cd backend/services/api-gateway && npm run lint"
  },
  "keywords": [
    "credit-card",
    "dashboard",
    "finance",
    "budgeting",
    "analytics"
  ],
  "author": "",
  "license": "MIT",
  "workspaces": [
    "frontend",
    "backend/services/*",
    "backend/shared",
    "database"
  ]
}
