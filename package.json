{
  "name": "credit-card-dashboard",
  "version": "1.0.0",
  "description": "Personal credit card management and analytics dashboard",
  "private": true,
  "scripts": {
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "backend:dev": "cd backend/services/api-gateway && npm run dev",
    "backend:build": "cd backend/services/api-gateway && npm run build",
    "db:migrate:up": "cd database && npm run migrate:up",
    "db:migrate:down": "cd database && npm run migrate:down",
    "lint": "npm run frontend:lint && npm run backend:lint",
    "frontend:lint": "cd frontend && npm run lint",
    "backend:lint": "cd backend/services/api-gateway && npm run lint",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend/services/api-gateway && npm test",
    "test:frontend": "cd frontend && npm test",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:coverage": "npm run test:backend -- --coverage && npm run test:frontend -- --coverage",
    "test:performance": "ts-node scripts/performance-test.ts",
    "typecheck": "cd backend/services/api-gateway && npm run typecheck",
    "typecheck:strict": "cd backend/services/api-gateway && npm run typecheck:strict",
    "format:check": "cd backend/services/api-gateway && npm run format:check",
    "deps:verify": "cd backend/services/api-gateway && npm run deps:verify",
    "render:simulate": "cd backend/services/api-gateway && npm run render:simulate",
    "prepush": "npm run deps:verify && npm run typecheck:strict && npm run lint && npm run render:simulate",
    "setup:quality-gate": "./setup-quality-gate.sh",
    "prepare": "husky || true"
  },
  "keywords": [
    "credit-card",
    "dashboard",
    "finance",
    "budgeting",
    "analytics"
  ],
  "author": "",
  "license": "MIT",
  "workspaces": [
    "frontend",
    "backend/services/*",
    "backend/shared",
    "database"
  ],
  "devDependencies": {
    "husky": "^9.0.0"
  },
  "dependencies": {
    "redis": "^4.7.1"
  }
}
